{
  "version": 2,
  "regions": ["hkg1"],
  "github": {
    "enabled": false
  },
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "rich_menu.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "api/webhook.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "api/modules/**",
          "api/handlers/**",
          "api/utils/**",
          "api/data/**",
          "accupass_cache.json",
          "restaurant_cache.json",
          "surprise_cache.json"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "index.html"
    },
    {
      "src": "/rich_menu.jpg",
      "dest": "rich_menu.jpg"
    },
    {
      "src": "/api/webhook",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/site_morning",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/site_food",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/site_activity",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/site_parking",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/site_transport",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/site_garbage",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/site_garbage_sources",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/site_health",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/site_deals",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/site_invoice",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/site_facilities",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/warm_cache",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/parking_worker",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/parking_debug",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/push_test",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/tdx_test",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/diag",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/morning_test",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/stats",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/debug_routes",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/richmenu_info",
      "dest": "api/webhook.py"
    },
    {
      "src": "/api/setup_richmenu",
      "dest": "api/webhook.py"
    }
  ]
}
